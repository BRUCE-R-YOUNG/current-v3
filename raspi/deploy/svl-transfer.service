[Unit]
Description=Sustainable Vision periodic queued image transfer
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/svl/raspi
EnvironmentFile=/home/pi/svl/raspi/config/transfer.env
ExecStart=/home/pi/svl/raspi/.venv/bin/python periodic_transfer.py --config /home/pi/svl/raspi/config/edge.yaml
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
